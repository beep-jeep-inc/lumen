<UserControl x:Class="Pult.App.Views.MaintenancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Pult.App.ViewModels"
             xmlns:local="clr-namespace:Pult.App.Views"
             FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
    <local:IndentConverter x:Key="Indent"/>
    <local:SpacedCapsConverter x:Key="Caps"/>
    <local:FirstLineConverter x:Key="FirstLine"/>
    <local:RestLinesConverter x:Key="RestLines"/>
    <local:ScaleConverter x:Key="Scale"/>
    <local:TileGapConverter x:Key="TileGap"/>
    <local:IsShortConverter x:Key="IsShort"/>
    <local:BoolToOneConverter x:Key="One"/>

    <!-- Кнопка строки: «Показать», «Свернуть», «Файлы серии» — ссылкой со стрелкой, остальные — контуром -->
    <Style x:Key="RowBtn" TargetType="Button" BasedOn="{StaticResource RowButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Text}" Value="Показать"><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource AccentHover}"/><Setter Property="ContentStringFormat" Value="{}{0}  →"/></DataTrigger>
        <DataTrigger Binding="{Binding Text}" Value="Файлы серии"><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource AccentHover}"/><Setter Property="ContentStringFormat" Value="{}{0}  →"/></DataTrigger>
        <DataTrigger Binding="{Binding Text}" Value="Свернуть"><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource AccentHover}"/><Setter Property="ContentStringFormat" Value="{}{0}  ↑"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Золотая черта перед подписью страницы -->
    <Style x:Key="Dash" TargetType="Rectangle">
      <Setter Property="Width" Value="20"/><Setter Property="Height" Value="2"/><Setter Property="Fill" Value="{StaticResource Gold}"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <!-- Щит администратора: контур 14, золото -->
    <Style x:Key="ShieldMark" TargetType="Path">
      <Setter Property="Data" Value="M7,1 L12.5,3 V7 C12.5,10.2 10.2,12.3 7,13.4 C3.8,12.3 1.5,10.2 1.5,7 V3 Z"/>
      <Setter Property="Stroke" Value="{StaticResource Gold}"/><Setter Property="StrokeThickness" Value="1.4"/><Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <!-- Кнопки действий (нижняя панель): одно главное — фиолетовая, остальные контурные -->
    <DataTemplate DataType="{x:Type vm:ActionVm}">
      <Grid Margin="8,2,0,2" Visibility="{Binding Visible, Converter={StaticResource BoolToVisibility}}">
        <Button Style="{StaticResource PrimaryButton}" Content="{Binding Text}" Command="{Binding Command}"
                Visibility="{Binding Primary, Converter={StaticResource BoolToVisibility}}"/>
        <Button Style="{StaticResource GhostButton}" Content="{Binding Text}" Command="{Binding Command}"
                Visibility="{Binding Secondary, Converter={StaticResource BoolToVisibility}}"/>
      </Grid>
    </DataTemplate>

    <!-- Предупреждение (прошивка BIOS): WarnBg, рамка Warn, значок, заголовок и текст целиком -->
    <DataTemplate DataType="{x:Type vm:NoticeVm}">
      <Border Margin="8,4,8,10" Padding="16,12" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource Warn}" Background="{StaticResource WarnBg}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{StaticResource Warn}" VerticalAlignment="Top" Margin="0,1,14,0"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Text}" FontSize="12.5" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Заголовок группы: золото, заглавными, пояснение рядом -->
    <DataTemplate DataType="{x:Type vm:HeaderVm}">
      <WrapPanel Margin="12,18,12,6">
        <TextBlock Style="{StaticResource Eyebrow}" Text="{Binding Text, Converter={StaticResource Caps}}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Sub, StringFormat='  •  {0}'}" FontSize="12" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" TextWrapping="Wrap"
                   Visibility="{Binding Sub, Converter={StaticResource EmptyToCollapsed}}"/>
      </WrapPanel>
    </DataTemplate>

    <!-- Строка списка: [галочка] [значок] название и пояснение | бейдж, размер, щит, кнопки. Разделитель под строкой. -->
    <DataTemplate DataType="{x:Type vm:RowVm}">
      <Border x:Name="row" MinHeight="56" Padding="12,10" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
              Opacity="{Binding Opacity}" Margin="{Binding Indent, Converter={StaticResource Indent}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{Binding Title}"
                    Visibility="{Binding CheckVisibility}"/>
          <TextBlock Grid.Column="1" Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{StaticResource TextDim}" FontSize="20" Width="24" Margin="0,0,12,0"
                     Visibility="{Binding Glyph, Converter={StaticResource EmptyToCollapsed}}"/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock FontSize="13.5" TextWrapping="Wrap" ToolTip="{Binding Title}" ToolTipService.Placement="Mouse" ToolTipService.InitialShowDelay="600">
              <Run Text="{Binding Title, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" ToolTip="{Binding Detail}" ToolTipService.Placement="Mouse" ToolTipService.InitialShowDelay="600" Margin="0,2,0,0"
                       Visibility="{Binding Detail, Converter={StaticResource EmptyToCollapsed}}"/>
          </StackPanel>

          <!-- Правая часть: не шире половины строки, при нехватке места переносится во вторую строку (название не сжимается до нескольких букв) -->
          <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
            <WrapPanel.Style>
              <Style TargetType="WrapPanel">
                <Setter Property="Grid.Column" Value="3"/>
                <Setter Property="MaxWidth" Value="{Binding ActualWidth, ElementName=row, Converter={StaticResource Scale}, ConverterParameter=0.5}"/>
                <Style.Triggers>
                  <!-- Длинные кнопки выхода из неудачи («Повторить с правами администратора») — отдельной строкой под текстом -->
                  <DataTrigger Binding="{Binding ButtonsBelow}" Value="True">
                    <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="2"/><Setter Property="Grid.ColumnSpan" Value="2"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="0,8,0,0"/><Setter Property="MaxWidth" Value="100000"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </WrapPanel.Style>
            <Path Style="{StaticResource ShieldMark}" ToolTip="{Binding ShieldTip}" Margin="0,0,10,0" VerticalAlignment="Center"
                  Visibility="{Binding Shield, Converter={StaticResource BoolToVisibility}}"/>
            <Border CornerRadius="8" Padding="8,3" MinHeight="22" VerticalAlignment="Center" Margin="0,2,10,2" Background="{Binding PillBackground}"
                    Visibility="{Binding Pill, Converter={StaticResource EmptyToCollapsed}}">
              <TextBlock Text="{Binding Pill}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding PillForeground}" MaxWidth="260" TextWrapping="Wrap" ToolTip="{Binding Pill}" ToolTipService.Placement="Mouse" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding Size}" FontSize="12.5" Foreground="{StaticResource TextDim}" MaxWidth="120" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                       Visibility="{Binding Size, Converter={StaticResource EmptyToCollapsed}}"/>

            <!-- Обычные кнопки строки -->
            <ItemsControl ItemsSource="{Binding Buttons}" VerticalAlignment="Center">
              <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                  <Style.Triggers><DataTrigger Binding="{Binding UseToggle}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                </Style>
              </ItemsControl.Style>
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource RowBtn}" Content="{Binding Text}" Command="{Binding Command}" Margin="4,2,0,2" AutomationProperties.Name="{Binding AutomationName}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Автозагрузка: «Включено / Выключено» и переключатель с подписью действия. Тот же ActionVm и та же команда, что у прежней кнопки. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers><DataTrigger Binding="{Binding UseToggle}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="{Binding ToggleText}" FontSize="13" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ItemsControl ItemsSource="{Binding Buttons}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel MinWidth="64" HorizontalAlignment="Center">
                      <Button Style="{StaticResource SwitchButton}" Command="{Binding Command}" Tag="{Binding Owner.ToggleOn, Converter={StaticResource One}}" AutomationProperties.Name="{Binding AutomationName}"
                              ToolTip="{Binding Text}" ToolTipService.Placement="Mouse"/>
                      <TextBlock FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,-2,0,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Text}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Owner.ToggleBusy}" Value="True"><Setter Property="Text" Value="Меняю…"/></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </WrapPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="row" Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{StaticResource RowHover}"/></Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Плитка «Обзора»: значок и подпись с точкой состояния, значение (Georgia), пояснение, «Открыть →». Кликабельна вся плитка. -->
    <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:SectionVm}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Top">
            <TextBlock Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                  <Setter Property="Foreground" Value="{StaticResource Text}"/>
                  <Style.Triggers><DataTrigger Binding="{Binding ShowTileValue}" Value="False"><Setter Property="Foreground" Value="{StaticResource TextMuted}"/></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
          <TextBlock Grid.Column="1" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Text}" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="14">
            <Run Text="{Binding Title, Converter={StaticResource Caps}, Mode=OneWay}"/><Run Text=" "/><InlineUIContainer BaselineAlignment="Center">
              <Ellipse Width="7" Height="7" Margin="2,0,0,0">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{StaticResource TextMuted}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding TileState}" Value="Ok"><Setter Property="Fill" Value="{StaticResource Ok}"/></DataTrigger>
                      <DataTrigger Binding="{Binding TileState}" Value="Warn"><Setter Property="Fill" Value="{StaticResource Warn}"/></DataTrigger>
                      <DataTrigger Binding="{Binding TileState}" Value="Info"><Setter Property="Fill" Value="{StaticResource Accent}"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
            </InlineUIContainer>
          </TextBlock>
        </Grid>

        <!-- Нет данных: вместо числа — спокойная строка; во время проверки — тонкая полоса -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,2" Visibility="{Binding ShowTileStatus, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding TileStatusText}" TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Left" Foreground="{StaticResource TextDim}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="14.5"/><Setter Property="LineHeight" Value="20"/>
                <Style.Triggers><Trigger Property="local:Layout.IsCompact" Value="True"><Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="18"/></Trigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Border Height="3" CornerRadius="1.5" Background="{StaticResource Line}" MaxWidth="200" HorizontalAlignment="Stretch" Margin="0,10,0,0" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}">
            <Border CornerRadius="1.5" Background="{StaticResource Accent}">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <Trigger Property="IsVisible" Value="True">
                      <Trigger.EnterActions>
                        <BeginStoryboard x:Name="tilePulse"><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.9"/></Storyboard></BeginStoryboard>
                      </Trigger.EnterActions>
                      <Trigger.ExitActions><StopStoryboard BeginStoryboardName="tilePulse"/></Trigger.ExitActions>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
            </Border>
          </Border>
        </StackPanel>

        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,2" Visibility="{Binding ShowTileValue, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{Binding TileValue}" FontFamily="{StaticResource NumFont}" FontWeight="Bold" VerticalAlignment="Center" LineStackingStrategy="BlockLineHeight"
                     LineHeight="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource Scale}, ConverterParameter=1.06}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding TileState}" Value="Off"><Setter Property="Foreground" Value="{StaticResource TextMuted}"/></DataTrigger>
                  <DataTrigger Binding="{Binding TileState}" Value="Ok"><Setter Property="Foreground" Value="{StaticResource Ok}"/></DataTrigger>
                  <DataTrigger Binding="{Binding TileState}" Value="Warn"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <!-- Вертикальная черта: только когда подпись справа от значения и режим не компактный -->
          <Border Grid.Column="1" Width="1" Margin="20,4,0,4" Background="{StaticResource Line}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding TileValue, Converter={StaticResource IsShort}}" Value="True"/>
                      <Condition Binding="{Binding Path=(local:Layout.IsCompact), RelativeSource={RelativeSource Self}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                  </MultiDataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="W"/>
                      <Condition Binding="{Binding Path=(local:Layout.IsCompact), RelativeSource={RelativeSource Self}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>
          <!-- Подпись: справа от значения (короткое значение; у широких плиток всегда в обычном режиме) или под ним -->
          <StackPanel MaxWidth="280" VerticalAlignment="Center">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="3"/>
                <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="0,2,0,0"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding TileValue, Converter={StaticResource IsShort}}" Value="True">
                    <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="2"/><Setter Property="Grid.ColumnSpan" Value="1"/><Setter Property="Margin" Value="20,0,0,0"/>
                  </DataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Path=(local:Layout.IsCompact), RelativeSource={RelativeSource Self}}" Value="False"/>
                      <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="W"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="2"/><Setter Property="Grid.ColumnSpan" Value="1"/><Setter Property="Margin" Value="20,0,0,0"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="{Binding TileCaption, Converter={StaticResource FirstLine}}" FontSize="13.5" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding TileCaption, Converter={StaticResource RestLines}}" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding TileCaption, Converter={StaticResource EmptyToCollapsed}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers><DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button Style="{StaticResource LinkButton}" Command="{Binding CheckCommand}" Margin="-8,-4,0,-5" Padding="8,4" HorizontalAlignment="Left"
                  AutomationProperties.Name="{Binding Title, StringFormat='Проверить: {0}'}" Visibility="{Binding ShowTileCheck, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="11" Margin="0,0,6,0"/>
              <TextBlock Text="Проверить" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>
          <TextBlock Grid.Column="1" Text="Открыть  →" FontSize="12.5" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ShowTileCheck}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Foreground" Value="{StaticResource TextMuted}"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Grid>
    </DataTemplate>

    <Style x:Key="Slot" TargetType="Button" BasedOn="{StaticResource TileButton}">
      <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- «Обзор»: приветствие и плитки (числа — из уже имеющихся данных раздела; новых сканов не запускают) -->
    <DataTemplate DataType="{x:Type vm:MaintenanceVm}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Rectangle Style="{StaticResource Dash}"/>
              <TextBlock Style="{StaticResource EyebrowDim}" Text="{Binding Eyebrow, Converter={StaticResource Caps}}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Greeting}" Margin="0,6,0,0"/>
            <TextBlock Style="{StaticResource PageHint}" Text="Всё проверяется только по кнопке. Выберите раздел слева или нажмите на плитку." Margin="0,6,0,0"/>
          </StackPanel>
          <!-- «Проверить всё»: только лёгкие чтения; подпись, ход работы или итог -->
          <StackPanel Grid.Column="1" Margin="24,2,0,0" VerticalAlignment="Top" Width="330">
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding QuickCheckCommand}" Padding="18,8" HorizontalAlignment="Right" AutomationProperties.Name="Проверить всё"
                    Visibility="{Binding QuickIdle, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="16" Margin="0,0,10,0"/>
                <TextBlock Text="Проверить всё" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Command="{Binding QuickStopCommand}" Padding="18,8" HorizontalAlignment="Right" AutomationProperties.Name="Остановить проверку"
                    Visibility="{Binding QuickRunning, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" FontSize="14" Margin="0,0,10,0"/>
                <TextBlock Text="Остановить" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBlock Text="Несколько секунд · только чтение, ничего не меняется" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" TextAlignment="Right" Margin="0,8,0,0"
                       Visibility="{Binding ShowQuickHint, Converter={StaticResource BoolToVisibility}}"/>
            <StackPanel Visibility="{Binding QuickRunning, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
              <Border Height="3" CornerRadius="1.5" Background="{StaticResource Line}">
                <Border CornerRadius="1.5" Background="{StaticResource Accent}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Style.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                          <Trigger.EnterActions>
                            <BeginStoryboard x:Name="quickPulse"><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.9"/></Storyboard></BeginStoryboard>
                          </Trigger.EnterActions>
                          <Trigger.ExitActions><StopStoryboard BeginStoryboardName="quickPulse"/></Trigger.ExitActions>
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                </Border>
              </Border>
              <TextBlock Text="{Binding QuickProgress}" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" TextAlignment="Right" Margin="0,8,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding QuickSummary}" FontSize="12" TextWrapping="Wrap" TextAlignment="Right" Margin="0,8,0,0" Visibility="{Binding ShowQuickSummary, Converter={StaticResource BoolToVisibility}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding QuickSummaryState}" Value="Ok"><Setter Property="Foreground" Value="{StaticResource Ok}"/></DataTrigger>
                    <DataTrigger Binding="{Binding QuickSummaryState}" Value="Warn"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- Ряд 1: две широкие плитки -->
            <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource TileButtonWide}" Tag="W" ContentTemplate="{StaticResource TileTemplate}" Content="{Binding Drivers}" AutomationProperties.Name="{Binding Drivers.Title}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Drivers}"
                    Margin="{Binding Path=(local:Layout.IsCompact), RelativeSource={RelativeSource Self}, Converter={StaticResource TileGap}, ConverterParameter='2,0,1'}"/>
            <Button Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Style="{StaticResource TileButtonWide}" Tag="W" ContentTemplate="{StaticResource TileTemplate}" Content="{Binding Cleanup}" AutomationProperties.Name="{Binding Cleanup.Title}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Cleanup}"
                    Margin="{Binding Path=(local:Layout.IsCompact), RelativeSource={RelativeSource Self}, Converter={StaticResource TileGap}, ConverterParameter='2,1,1'}"/>
            <!-- Ряды 2 и 3: по три плитки -->
            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource TileButton}" Tag="" ContentTemplate="{StaticResource TileTemplate}" Content="{Binding Libraries}" AutomationProperties.Name="{Binding Libraries.Title}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Libraries}"
                    Margin="{Binding Path=(local:Layout.IsCompact), RelativeSource={RelativeSource Self}, Converter={StaticResource TileGap}, ConverterParameter='3,0,1'}"/>
            <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource TileButton}" Tag="" ContentTemplate="{StaticResource TileTemplate}" Content="{Binding Programs}" AutomationProperties.Name="{Binding Programs.Title}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Programs}"
                    Margin="{Binding Path=(local:Layout.IsCompact), RelativeSource={RelativeSource Self}, Converter={StaticResource TileGap}, ConverterParameter='3,1,1'}"/>
            <Button Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Style="{StaticResource TileButton}" Tag="" ContentTemplate="{StaticResource TileTemplate}" Content="{Binding Space}" AutomationProperties.Name="{Binding Space.Title}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Space}"
                    Margin="{Binding Path=(local:Layout.IsCompact), RelativeSource={RelativeSource Self}, Converter={StaticResource TileGap}, ConverterParameter='3,2,1'}"/>
            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource TileButton}" Tag="" ContentTemplate="{StaticResource TileTemplate}" Content="{Binding Startup}" AutomationProperties.Name="{Binding Startup.Title}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Startup}"
                    Margin="{Binding Path=(local:Layout.IsCompact), RelativeSource={RelativeSource Self}, Converter={StaticResource TileGap}, ConverterParameter='3,0,1'}"/>
            <Button Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource TileButton}" Tag="" ContentTemplate="{StaticResource TileTemplate}" Content="{Binding Disks}" AutomationProperties.Name="{Binding Disks.Title}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Disks}"
                    Margin="{Binding Path=(local:Layout.IsCompact), RelativeSource={RelativeSource Self}, Converter={StaticResource TileGap}, ConverterParameter='3,1,1'}"/>
            <Button Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" Style="{StaticResource TileButton}" Tag="" ContentTemplate="{StaticResource TileTemplate}" Content="{Binding Repair}" AutomationProperties.Name="{Binding Repair.Title}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Repair}"
                    Margin="{Binding Path=(local:Layout.IsCompact), RelativeSource={RelativeSource Self}, Converter={StaticResource TileGap}, ConverterParameter='3,2,1'}"/>

            <!-- Принцип работы -->
            <Border Grid.Row="3" Grid.ColumnSpan="6" Style="{StaticResource CardBorderStyle}" Padding="20,10" Margin="0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                  <Path Style="{StaticResource ShieldMark}" Stroke="{StaticResource Text}" StrokeThickness="1.6" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Rectangle Style="{StaticResource Dash}" Width="16"/>
                    <TextBlock Style="{StaticResource EyebrowDim}" Text="{Binding Source='Принцип работы', Converter={StaticResource Caps}}"/>
                  </StackPanel>
                  <TextBlock Text="Ничего не работает в фоне" FontFamily="{StaticResource SerifFont}" FontWeight="Bold" FontSize="24" Margin="0,2,0,0" TextWrapping="Wrap"/>
                  <TextBlock Text="Проверки и изменения — только по вашей кнопке, а всё серьёзное — после подтверждения." FontSize="12.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>
      </Grid>
    </DataTemplate>

    <!-- Раздел: заголовок и кнопка проверки сверху; карточка: единственный прокручиваемый список и закреплённая нижняя панель действий -->
    <DataTemplate DataType="{x:Type vm:SectionVm}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,20,0,0">
            <Button Style="{StaticResource GhostButton}" Content="Отмена" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                    Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}"/>
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding CheckCommand}" Padding="18,8" AutomationProperties.Name="{Binding CheckText}"
                    Visibility="{Binding HasCheck, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding CheckGlyph}" FontSize="16" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding CheckText}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Rectangle Style="{StaticResource Dash}"/>
              <TextBlock Style="{StaticResource EyebrowDim}" Text="{Binding Eyebrow, Converter={StaticResource Caps}}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" Margin="0,4,0,0"/>
            <TextBlock Style="{StaticResource PageHint}" Text="{Binding Hint}" Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" local:ScrollBehavior.ResetToken="{Binding ScrollToken}" local:ScrollBehavior.TargetToken="{Binding ScrollToToken}">
              <StackPanel Margin="6,6,10,10">
                <TextBlock Text="{Binding EmptyText}" FontSize="13.5" Foreground="{StaticResource TextDim}" Margin="12,12,12,6" TextWrapping="Wrap"
                           Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Items}"/>
              </StackPanel>
            </ScrollViewer>

            <!-- Нижняя панель: слева прогресс или итог, справа главные кнопки; растёт при нехватке места, список над ней уменьшается -->
            <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12" MinHeight="72"
                    Visibility="{Binding ShowFooter, Converter={StaticResource BoolToVisibility}}">
              <Grid x:Name="footer">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <!-- Слева итог/прогресс, справа кнопки; в компактном режиме кнопки уходят строкой под итог (кнопки переносятся, ничего не выходит за ширину) -->
                <StackPanel VerticalAlignment="Center">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Margin" Value="0,0,16,0"/>
                      <Style.Triggers>
                        <Trigger Property="local:Layout.IsCompact" Value="True"><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0,0,0,2"/></Trigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <!-- Идёт работа: полоса 4 DIP (процент неизвестен — просто «идёт») и строка прогресса -->
                  <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <Border Height="4" CornerRadius="2" Background="{StaticResource Line}" HorizontalAlignment="Stretch" MaxWidth="460">
                      <Border x:Name="pulse" CornerRadius="2" Background="{StaticResource Accent}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Style.Triggers>
                              <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                  <BeginStoryboard x:Name="pulseStory"><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.9"/></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions><StopStoryboard BeginStoryboardName="pulseStory"/></Trigger.ExitActions>
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>
                    </Border>
                    <TextBlock Text="{Binding Progress}" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <!-- Итог: значок состояния, строка итога и пояснение под ней -->
                  <Grid Visibility="{Binding Result, Converter={StaticResource EmptyToCollapsed}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="14" BorderThickness="2" VerticalAlignment="Top" Margin="0,0,12,0">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="BorderBrush" Value="{StaticResource Ok}"/>
                          <Style.Triggers><DataTrigger Binding="{Binding ResultIsError}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ErrText}"/></DataTrigger></Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock HorizontalAlignment="Center" FontSize="13">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                            <Setter Property="Text" Value="&#xE73E;"/><Setter Property="Foreground" Value="{StaticResource Ok}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding ResultIsError}" Value="True"><Setter Property="Text" Value="&#xE7BA;"/><Setter Property="Foreground" Value="{StaticResource ErrText}"/></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Result}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Ok}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding ResultIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrText}"/></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <!-- Пояснение целиком (при очень длинном — прокручивается, чтобы список над панелью не исчезал) -->
                      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="130" Margin="0,2,0,0"
                                    Visibility="{Binding Notes, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock Text="{Binding Notes}" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                      </ScrollViewer>
                    </StackPanel>
                  </Grid>
                  <!-- Без итога, но с пояснением -->
                  <TextBlock Text="{Binding Notes}" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding Result}" Value=""/>
                              <Condition Binding="{Binding IsBusy}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Actions}" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                      <Setter Property="MaxWidth" Value="{Binding ActualWidth, ElementName=footer, Converter={StaticResource Scale}, ConverterParameter=0.62}"/>
                      <Style.Triggers>
                        <Trigger Property="local:Layout.IsCompact" Value="True"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="MaxWidth" Value="100000"/></Trigger>
                      </Style.Triggers>
                    </Style>
                  </ItemsControl.Style>
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- Сообщение окна (ошибка сохранения, баннер запуска): предупреждение WarnBg с рамкой Warn -->
    <Border Margin="0,0,0,12" Padding="16,10" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource Warn}" Background="{StaticResource WarnBg}" Visibility="{Binding Banner, Converter={StaticResource EmptyToCollapsed}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕" Padding="8,2" MinWidth="32" MinHeight="28" Command="{Binding CloseBannerCommand}" AutomationProperties.Name="Закрыть сообщение"/>
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{StaticResource Warn}" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13"/>
      </DockPanel>
    </Border>
    <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
  </Grid>
</UserControl>
