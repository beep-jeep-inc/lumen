<Window x:Class="Pult.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pult.App.Views"
        Title="Lumen — обслуживание" Icon="/Assets/pult.ico" Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource Text}"
        Background="{StaticResource WindowBg}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <local:SpacedCapsConverter x:Key="Caps"/>
    <local:BoolToOneConverter x:Key="One"/>
    <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
    <!-- Иконка пункта меню: 18 (в компактном режиме 16) -->
    <Style x:Key="NavGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
      <Setter Property="Width" Value="25"/>
      <Setter Property="FontSize" Value="18"/>
      <Style.Triggers><Trigger Property="local:Layout.IsCompact" Value="True"><Setter Property="FontSize" Value="16"/><Setter Property="Width" Value="24"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="LogoText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource SerifFont}"/><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="12,0,0,2"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers><Trigger Property="local:Layout.IsCompact" Value="True"><Setter Property="FontSize" Value="26"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="NavCheckText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Style.Triggers><Trigger Property="local:Layout.IsCompact" Value="True"><Setter Property="FontSize" Value="11.5"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="NavNote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{StaticResource TextMuted}"/><Setter Property="Margin" Value="27,5,0,0"/>
      <Style.Triggers><Trigger Property="local:Layout.IsCompact" Value="True"><Setter Property="FontSize" Value="11"/></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid x:Name="Root">
    <Rectangle Fill="{StaticResource GlowBrush}" IsHitTestVisible="False"/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <!-- Меню слева: закреплённый блок автозапуска внизу, пункты при нехватке места прокручиваются отдельно -->
      <Border Grid.Column="0" Background="{StaticResource NavPanel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel Margin="12,12,12,16">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,18">
            <Viewbox Width="34" Height="34" Stretch="Uniform">
              <Canvas Width="34" Height="34">
                <Path Data="M17,1 Q18.2,15.8 33,17 Q18.2,18.2 17,33 Q15.8,18.2 1,17 Q15.8,15.8 17,1 Z">
                  <Path.Fill>
                    <RadialGradientBrush><GradientStop Color="#FFF3CD" Offset="0"/><GradientStop Color="#E3B85C" Offset="1"/></RadialGradientBrush>
                  </Path.Fill>
                </Path>
                <Path Data="M17,8 Q17.6,16.4 26,17 Q17.6,17.6 17,26 Q16.4,17.6 8,17 Q16.4,16.4 17,8 Z" Fill="#FFF3CD" Opacity="0.9"/>
              </Canvas>
            </Viewbox>
            <TextBlock Text="Lumen" Style="{StaticResource LogoText}"/>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="8,12,0,0">
            <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14"/>
            <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Top"
                      ToolTip="При входе в Windows Lumen откроется свёрнутым на панели задач. По умолчанию выключено.">
              <TextBlock Text="Запускать вместе с Windows" TextWrapping="Wrap" Style="{StaticResource NavCheckText}"/>
            </CheckBox>
            <TextBlock Text="Lumen будет открываться свёрнутым при входе в Windows" TextWrapping="Wrap" Style="{StaticResource NavNote}"/>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextMuted}" Margin="12,0,0,10" Text="{Binding Source='Обслуживание', Converter={StaticResource Caps}}"/>
              <ItemsControl ItemsSource="{Binding Nav}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource NavButton}" Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Section}" Tag="{Binding IsSelected, Converter={StaticResource One}}" AutomationProperties.Name="{Binding Title}">
                      <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0" Margin="2,0,0,0" Background="{StaticResource WarnBg}" VerticalAlignment="Center"
                                Visibility="{Binding Badge, Converter={StaticResource EmptyToCollapsed}}">
                          <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Warn}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource NavGlyph}" Text="{Binding Glyph}"/>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Правая часть: выбранный раздел -->
      <ContentControl x:Name="PageHost" Grid.Column="1" Margin="24,20,24,24"/>
    </Grid>
  </Grid>
</Window>
